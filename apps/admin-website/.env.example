# Server-side runtime settings for admin-website. Copy to .env.local for local development.
# These are read at RUNTIME on the server, so one build can be deployed to staging and production.
API_BASE_URL=http://localhost:5080
APP_ENV=LOCAL

# Where the public site runs, and the shared secret for refreshing its cached pages after an approval.
# Both must match apps/main-website. Leave either empty to turn the refresh off.
MAIN_SITE_URL=http://localhost:3000
REVALIDATE_TOKEN=
