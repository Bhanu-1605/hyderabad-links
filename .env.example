# Local development values only. Copy to .env and adjust. NEVER commit .env.
# These are throwaway local credentials for the Docker services, not real secrets.

# SQL Server: the application database. SQL Server rejects a weak password outright, so this one
# has the upper case, lower case, digit and length it insists on.
MSSQL_SA_PASSWORD=Hl_dev_password_change_me1
MSSQL_PORT=1433

# PostgreSQL: no longer used by the application, kept only to read the pre-conversion dev database
# (docker compose --profile legacy up -d).
POSTGRES_DB=hyderabad_links
POSTGRES_USER=hl_dev
POSTGRES_PASSWORD=hl_dev_password_change_me
POSTGRES_PORT=5432
